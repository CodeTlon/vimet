# Solo NOMBRES de variables, sin valores reales. Copiar a .env.local para desarrollo; en Coolify se cargan en el recurso.
# Entornos: dev = local (Postgres de docker-compose.yml), test y main = recursos de Coolify (docker-compose.coolify.yml),
# cada uno con su propia base, archivos y secretos. Detalle: docs/environments.md

# --- Base y entorno ---
APP_ENV=development            # development | test | production
DATABASE_URL=postgres://vimet:CAMBIAR@localhost:5432/vimet   # en Coolify lo arma el compose

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=            # obligatoria; openssl rand -base64 48 | tr -d '\n=+/' | cut -c1-64; distinta por entorno
BETTER_AUTH_URL=http://localhost:3000

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # variable de BUILD
NEXT_PUBLIC_GA_ID=                           # opcional; variable de BUILD

# --- Archivos (volumen servido por /media) ---
STORAGE_DIR=./storage
STORAGE_PUBLIC_URL=http://localhost:3000/media
MEDIA_SIGNING_SECRET=          # opcional; si falta se usa BETTER_AUTH_SECRET

# --- Datos clínicos ---
CLINICAL_DATA_ENCRYPTION_KEY=  # obligatoria; openssl rand -base64 32 (32 bytes); distinta por entorno, nunca en el repo

# --- Correo (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
COMPANY_EMAIL=
MAIL_SANDBOX_TO=              # obligatoria en test, prohibida en prod

# --- Video (servicio global de compresión, opcional) ---
TRANSCODE_SERVICE_URL=
TRANSCODE_API_KEY=            # solo en Coolify, nunca en el repo

# --- Solo para el corte desde Supabase (scripts/migracion, ver docs/migracion/) ---
SOURCE_DATABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
