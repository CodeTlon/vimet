# ===================================================================
# Vimet — Variables de entorno
# ===================================================================
# Copiar a .env.local y completar. NUNCA committear .env.local.
# Dos entornos (ver docs/environments.md):
#   dev  → Supabase vimet-dev  (Vercel Preview)
#   prod → Supabase vimet-prod (Vercel Production)
# En local apuntá SIEMPRE a vimet-dev, nunca a prod.
# ===================================================================

# Supabase — DISTINTO por entorno (dev=vimet-dev, prod=vimet-prod)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cifrado de campos clínicos sensibles (fichas_paciente, evolucion_entradas,
# planes.notas) — ver lib/crypto/clinical.ts. Clave simétrica AES-256, 32 bytes
# en base64. DISTINTA por entorno (dev/prod) — nunca reusar la de prod en dev,
# y nunca commitear el valor real. Generarla con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CRÍTICO: tiene que estar seteada en el entorno de destino ANTES de deployar
# el código que la usa — sin esta env var, guardar o abrir una ficha/evolución/
# plan tira error (falla ruidoso a propósito, no guarda ni muestra datos sin cifrar).
CLINICAL_DATA_ENCRYPTION_KEY=

# Resend (formulario contacto público) — compartido entre entornos
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
COMPANY_EMAIL=hola@vimet.com

# App — DISTINTO por entorno: apuntar al dominio del entorno (dev usa la URL de la Preview)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GA4 — opcional. Crear la propiedad en Google Analytics y pegar el Measurement ID (G-XXXXXXXXXX) acá.
# Sin esta variable (o con el placeholder), no se carga GA ni se muestra el banner de cookies.
NEXT_PUBLIC_GA_ID=
